# Copy to .env and edit:  cp .env.example .env
# NEVER commit .env to Git (it is listed in .gitignore).

# --- Database (used by docker-compose) ---
# Use letters and digits only (the password is placed inside a database URL).
DB_PASSWORD=ChangeThisPassword123

# --- Backend ---
JWT_SECRET=change-me-to-a-long-random-string      # generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
DEV_OTP_ECHO=true             # true = OTP is shown on screen (development). MUST be false in production.
SEED_DEMO_DATA=true           # true = fake demo prices. Set false once real data is loaded.
CORS_ORIGINS=*                # production: your real site, e.g. https://krishisense.example.com
CONFIDENCE_THRESHOLD=0.6      # below this the app says "not sure" instead of guessing

# --- AWS (leave S3_BUCKET empty to store images locally) ---
S3_BUCKET=
AWS_REGION=ap-south-1
# On AWS use IAM roles (task role / instance role). Do NOT put access keys here.

# --- Ingestion job ---
DATA_GOV_API_KEY=             # free key from https://data.gov.in (register, then "My Account")
INGEST_STATE=Karnataka

# --- SMS and push price alerts ---
SMS_PROVIDER=log              # log = only print to the log (development). sns = real SMS through Amazon SNS.
SNS_SENDER_ID=                # India (DLT): your approved sender id / header, e.g. KRSENS
SNS_ENTITY_ID=                # India (DLT): principal entity id
SNS_TEMPLATE_ID=              # India (DLT): approved template id
# Browser/phone push. Generate once:  python backend/scripts/generate_vapid.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
